[Unit]
Description=Class++ API
After=network.target

[Service]
Type=simple
User=classpp
Group=classpp
WorkingDirectory=/opt/classpp/server
EnvironmentFile=/etc/classpp/env
ExecStart=/usr/bin/node /opt/classpp/server/src/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/classpp
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
