# Append this block to /etc/caddy/Caddyfile on minerva-prod and reload:
#   sudo systemctl reload caddy
#
# Caddy auto-manages TLS. Cloudflare proxies the zone (orange cloud) in
# "Full" mode, which accepts Caddy's local cert (same setup as
# minerva.thefarshad.com on this host). Logs go to journald via Caddy's
# default; access them with: sudo journalctl -u caddy -f

api.thefarshad.com {
    tls internal
    encode gzip zstd

    # Allow large multipart uploads (videos pass through us before going to Drive).
    request_body {
        max_size 220MB
    }

    reverse_proxy 127.0.0.1:3001
}
