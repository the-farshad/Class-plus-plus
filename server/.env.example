# Class++ API — copy to .env for local dev. In production (Render) set these as
# service env vars instead; secrets never live in git.

# --- Web ---
PORT=3001
# Comma-separated list of origins allowed by CORS.
ALLOWED_ORIGINS=https://cpp.thefarshad.com,http://localhost:8000

# --- Auth ---
# Google OAuth Web Client ID (Cloud Console → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
# Email domain auto-allowed without an allowlist entry.
ALLOWED_DOMAIN=uwyo.edu
# Long random string used to sign app JWTs (rotate to invalidate all sessions).
JWT_SECRET=REPLACE_ME_WITH_64_RANDOM_BYTES

# --- Database ---
# Turso (managed libSQL) for production. When TURSO_DATABASE_URL is set, DB_PATH
# is ignored.
#   turso db create classpp
#   turso db show classpp --url        -> TURSO_DATABASE_URL (libsql://…)
#   turso db tokens create classpp     -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local fallback, used only when TURSO_DATABASE_URL is empty.
DB_PATH=./data.db

# --- Storage (attachments) ---
# Local dir for dev; on a serverless host all uploads go to Drive instead.
UPLOAD_DIR=./uploads
# Anything strictly larger than this routes to Drive (default 5 MB). Videos always
# go to Drive. Once Drive credentials are set, everything goes to Drive.
DRIVE_THRESHOLD_BYTES=5242880
# Hard cap on a single upload (default 200 MB).
MAX_UPLOAD_BYTES=209715200

# --- Google Drive (service account) ---
# Preferred: paste the service-account JSON *contents* inline (serverless-friendly,
# no file on disk).
GOOGLE_DRIVE_SA_JSON=
# Or, for local dev: path to the service-account JSON key file.
DRIVE_KEY_PATH=
# ID of the shared Drive folder the service account writes into.
DRIVE_FOLDER_ID=REPLACE_ME

# --- Bootstrap ---
# Comma-separated emails granted instructor role on first start (idempotent).
INITIAL_INSTRUCTORS=farshad.1991@gmail.com
