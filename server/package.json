{
  "name": "classpp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Class++ backend API. Runs on the minerva-prod droplet, fronted by nginx.",
  "type": "module",
  "engines": { "node": ">=18" },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node -e \"import('./src/db.js').then(m => m.migrate())\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^9.14.2",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "multer": "^1.4.5-lts.1"
  }
}
