#!/usr/bin/env bash
# Bumps js/version.js (build number, version string, builtAt) AND rewrites
# `?v=BUILD` cache-busters on every <link> / <script src> in every HTML file
# under the repo. This guarantees browsers always pull the fresh CSS/JS for
# the current build instead of serving stale cached copies.
#
# Usage:  ./bin/bump-version
#
# Wired into bin/hooks/pre-commit so it runs automatically on every commit.

set -euo pipefail

cd "$(dirname "$0")/.."
VERSION_FILE="js/version.js"

if [[ ! -f "$VERSION_FILE" ]]; then
  echo "error: $VERSION_FILE not found" >&2
  exit 1
fi

# Pull the current build number out of the file.
current=$(sed -n 's/.*build: *\([0-9]\+\).*/\1/p' "$VERSION_FILE" | head -n1)
if [[ -z "$current" ]]; then
  echo "error: could not parse current build number from $VERSION_FILE" >&2
  exit 1
fi

next=$((current + 1))
date_prefix=$(date -u +"%Y.%m")
built_at=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
new_version="${date_prefix}.${next}"

cat > "$VERSION_FILE" <<EOF
// Auto-generated by bin/bump-version. Do not edit by hand —
// run \`./bin/bump-version\` (or \`npm version\`-style equivalents) instead.
export const VERSION = {
  build: ${next},
  version: "${new_version}",
  builtAt: "${built_at}",
};
EOF

# --- HTML cache-busting --------------------------------------------------
# Rewrite `?v=NN` (or insert it) on every internal CSS / JS reference inside
# the project's HTML files. We deliberately leave external CDN URLs alone.

# Files: every *.html in the repo, excluding node_modules and .git.
mapfile -t html_files < <(
  find . \
    -path './server/node_modules' -prune -o \
    -path './.git' -prune -o \
    -name '*.html' -print
)

# Patterns we touch: hrefs/srcs that start with "/css/...css" or "/js/...js"
# inside double quotes. Captures the path up to the extension, then any
# existing query, and replaces with `?v=$next`.
for f in "${html_files[@]}"; do
  # /css/foo.css(?v=anything|"") -> /css/foo.css?v=NEXT
  sed -i -E "s|(\"/css/[^\"?]+\\.css)(\\?v=[^\"]*)?\"|\\1?v=${next}\"|g" "$f"
  # /js/foo.js(?v=anything|"")  -> /js/foo.js?v=NEXT
  sed -i -E "s|(\"/js/[^\"?]+\\.js)(\\?v=[^\"]*)?\"|\\1?v=${next}\"|g" "$f"
done

# --- JS module import cache-busting --------------------------------------
# Without this, the entry .js file gets a fresh ?v=NEXT in the HTML but its
# `import "/js/api.js"` still serves a cached api.js, so newly-added api
# methods appear undefined in the browser even after a deploy. Rewrite
# both `from "..."` and bare `import "..."` forms.

mapfile -t js_files < <(
  find ./js -name '*.js' -not -name 'version.js'
)

for f in "${js_files[@]}"; do
  # from "/js/foo.js"            -> from "/js/foo.js?v=NEXT"
  # from "/js/foo.js?v=anything" -> from "/js/foo.js?v=NEXT"
  sed -i -E "s|(from \"/js/[^\"?]+\\.js)(\\?v=[^\"]*)?\"|\\1?v=${next}\"|g" "$f"
  # Bare side-effect import: import "/js/foo.js"
  sed -i -E "s|(import \"/js/[^\"?]+\\.js)(\\?v=[^\"]*)?\"|\\1?v=${next}\"|g" "$f"
done

echo "Bumped build ${current} → ${next}  (v${new_version})  — cache-busters updated in ${#html_files[@]} HTML + ${#js_files[@]} JS files"
