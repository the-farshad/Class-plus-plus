#!/usr/bin/env bash
# Bumps js/version.js — increments build number, rewrites version string
# (YYYY.MM.build), and stamps builtAt to the current UTC time.
#
# Usage:  ./bin/bump-version
#
# Run this before each commit you want users to see as a new deploy.
# The build number is monotonically increasing; the YYYY.MM prefix gives a
# rough sense of when the build was cut.

set -euo pipefail

cd "$(dirname "$0")/.."
VERSION_FILE="js/version.js"

if [[ ! -f "$VERSION_FILE" ]]; then
  echo "error: $VERSION_FILE not found" >&2
  exit 1
fi

# Pull the current build number out of the file.
current=$(sed -n 's/.*build: *\([0-9]\+\).*/\1/p' "$VERSION_FILE" | head -n1)
if [[ -z "$current" ]]; then
  echo "error: could not parse current build number from $VERSION_FILE" >&2
  exit 1
fi

next=$((current + 1))
date_prefix=$(date -u +"%Y.%m")
built_at=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
new_version="${date_prefix}.${next}"

cat > "$VERSION_FILE" <<EOF
// Auto-generated by bin/bump-version. Do not edit by hand —
// run \`./bin/bump-version\` (or \`npm version\`-style equivalents) instead.
export const VERSION = {
  build: ${next},
  version: "${new_version}",
  builtAt: "${built_at}",
};
EOF

echo "Bumped build ${current} → ${next}  (v${new_version})"
